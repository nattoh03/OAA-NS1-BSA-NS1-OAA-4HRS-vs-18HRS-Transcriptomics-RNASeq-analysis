#!/bin/bash
#SBATCH --job-name=fastp_trim2
#SBATCH --output=logs/fastp2_%j.out
#SBATCH --error=logs/fastp2_%j.err
#SBATCH --time=06:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --partition=day

# Load modules if required by your HPC environment (uncomment/adjust if needed)
# module load fastp
module load fastp/0.23.2-GCCcore-10.2.0

# Define directories relative to your working directory
BASE_DIR="$HOME/palmer_scratch/RNASeq"
RAW_DIR="${BASE_DIR}/raw_data"
TRIM_DIR="${BASE_DIR}/trimmed_data2"
REPORT_DIR="${BASE_DIR}/fastp_reports2"

# Create output directories if they don't exist
mkdir -p "${TRIM_DIR}"
mkdir -p "${REPORT_DIR}"
mkdir -p "${BASE_DIR}/logs2"

echo "Starting fastp trimming job at $(date)"
echo "--------------------------------------------------"

# Loop through each sample folder in raw_data
# Loop through each R1 file directly in raw_data
for r1_file in "${RAW_DIR}"/*_R1_001.fastq.gz; do
    if [ -f "$r1_file" ]; then
        # Derive the corresponding R2 filename
        r2_file="${r1_file/_R1_001.fastq.gz/_R2_001.fastq.gz}"
        
        # Extract the sample prefix (e.g., Sample_10_S10_L004)
        r1_name=$(basename "$r1_file")
        prefix="${r1_name%_R1_001.fastq.gz}"
        
        if [ -f "$r2_file" ]; then
            echo "Processing sample: $prefix"
            
            fastp \
                -i "$r1_file" \
                -I "$r2_file" \
                -o "${TRIM_DIR}/${prefix}_R1_val_1.fastq.gz" \
                -O "${TRIM_DIR}/${prefix}_R2_val_2.fastq.gz" \
                --detect_adapter_for_pe \
                --qualified_quality_phred 20 \
                --length_required 50 \
                --thread 8 \
                -h "${REPORT_DIR}/${prefix}_fastp.html" \
                -j "${REPORT_DIR}/${prefix}_fastp.json"
        else
            echo "Warning: Corresponding R2 file not found for $r1_file"
        fi
    fi
done

echo "--------------------------------------------------"
echo "Trimming completed successfully at $(date)"
echo "--------------------------------------------------"







#!/bin/bash
#SBATCH --job-name=fastqc_Trimmedreads
#SBATCH --output=fastqc_trim_%j.out
#SBATCH --error=fastqc_trim_%j.err
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --partition=day

# Load required modules (adjust module names if your cluster uses specific versions)
module load FastQC/0.12.1-Java-11

module load MultiQC/1.10.1-foss-2020b-Python-3.8.6

# Set paths
RAW_DIR="/home/gi64/palmer_scratch/RNASeq/trimmed_data2"

OUT_DIR="/home/gi64/palmer_scratch/RNASeq/trimmed_data2/fastqc_trimmed"

# Create output directory if it doesn't exist
mkdir -p "$OUT_DIR"

echo "Starting FastQC on trimmed reads at $(date)"

# Find all compressed FASTQ files and run FastQC in parallel safely
find "$RAW_DIR" -maxdepth 1 -type f \( -name "*.fastq.gz" -o -name "*.fq.gz" \) | xargs -n 1 -P ${SLURM_CPUS_PER_TASK:-4} fastqc -o "$OUT_DIR"

echo "FastQC completed at $(date)"

# Run MultiQC to generate an aggregated HTML report
echo "Running MultiQC..."
multiqc "$OUT_DIR" -o "$OUT_DIR"

echo "Pipeline finished successfully at $(date)"









